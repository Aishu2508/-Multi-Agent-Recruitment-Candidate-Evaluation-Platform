  "components": {
    "schemas": {
      "AssessmentCreate": {
        "properties": {
          "candidate_id": {
            "type": "integer",
            "title": "Candidate Id"
          },
          "job_id": {
            "type": "integer",
            "title": "Job Id"
          }
        },
        "type": "object",
        "required": [
          "candidate_id",
          "job_id"
        ],
        "title": "AssessmentCreate"
      },
      "AssessmentResponse": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "candidate_id": {
            "type": "integer",
            "title": "Candidate Id"
          },
          "job_id": {
            "type": "integer",
            "title": "Job Id"
          },
          "match_percentage": {
            "type": "number",
            "title": "Match Percentage"
          },
          "matched_skills": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Matched Skills"
          },
          "missing_skills": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Missing Skills"
          },
          "semantic_search_score": {
            "type": "number",
            "title": "Semantic Search Score"
          },
          "technical_score": {
            "type": "number",
            "title": "Technical Score"
          },
          "coding_score": {
            "type": "number",
            "title": "Coding Score"
          },
          "communication_score": {
            "type": "number",
            "title": "Communication Score"
          },
          "final_score": {
            "type": "number",
            "title": "Final Score"
          },
          "performance_level": {
            "type": "string",
            "title": "Performance Level"
          },
          "decision": {
            "type": "string",
            "title": "Decision"
          },
          "hr_approved": {
            "type": "boolean",
            "title": "Hr Approved"
          },
          "hr_feedback": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Hr Feedback"
          },
          "notification_sent": {
            "type": "boolean",
            "title": "Notification Sent"
          },
          "workflow_stage": {
            "type": "string",
            "title": "Workflow Stage"
          },
          "interview_log": {
            "items": {},
            "type": "array",
            "title": "Interview Log"
          },
          "coding_submission": {
            "additionalProperties": true,
            "type": "object",
            "title": "Coding Submission"
          },
          "communication_log": {
            "additionalProperties": true,
            "type": "object",
            "title": "Communication Log"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "candidate_id",
          "job_id",
          "match_percentage",
          "matched_skills",
          "missing_skills",
          "semantic_search_score",
          "technical_score",
          "coding_score",
          "communication_score",
          "final_score",
          "performance_level",
          "decision",
          "hr_approved",
          "notification_sent",
          "workflow_stage",
          "interview_log",
          "coding_submission",
          "communication_log",
          "created_at"
        ],
        "title": "AssessmentResponse"
      },
      "Body_upload_resume_api_candidates_upload_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
